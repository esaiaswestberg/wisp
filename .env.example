# Caddy hostname. Use a real domain in production.
BLOG_DOMAIN=blog.example.com

# Used by canonical links, feeds, sitemap, and secure cookies.
# Set this to the same public URL as BLOG_DOMAIN.
BLOG_BASE_URL=https://blog.example.com

# Optional setup defaults. The setup UI remains the source of truth afterward.
BLOG_SITE_NAME=Wisp
BLOG_SITE_DESCRIPTION=A small, fast blog.
BLOG_AUTHOR=

# S3 or Cloudflare R2
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_MAX_UPLOAD_MB=10
S3_PATH_STYLE=false
